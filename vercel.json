{
  "installCommand": "npm ci",
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "urbanconnectstore.com"
        }
      ],
      "destination": "https://www.view2connect.ng/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin-portal",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/admin-portal/(.*)",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/catalog-admin",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/catalog-admin/(.*)",
      "destination": "/admin-portal/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/app/index.html"
    },
    {
      "source": "/dispatch-login",
      "destination": "/app/index.html"
    },
    {
      "source": "/dispatch-login/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/seller-portal",
      "destination": "/seller-portal/index.html"
    },
    {
      "source": "/seller-portal/(.*)",
      "destination": "/seller-portal/index.html"
    }
  ]
}
