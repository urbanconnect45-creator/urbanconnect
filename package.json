{
  "name": "urbanconnect",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client --scheme urbanconnect",
    "start:local": "set EXPO_PUBLIC_URBANCONNECT_LOCAL_TEST_MODE=true&& expo start --dev-client --scheme urbanconnect",
    "start:dev-client": "expo start --dev-client --scheme urbanconnect",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:local": "set EXPO_PUBLIC_URBANCONNECT_LOCAL_TEST_MODE=true&& expo start --web",
    "export:web": "node scripts/export-web.mjs",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "desktop:prepare": "npm install --prefix electron --ignore-scripts --no-audit --no-fund",
    "desktop:build:win": "npm run desktop:prepare && npm run export:web && electron-builder --win nsis",
    "desktop:dir": "npm run desktop:prepare && npm run export:web && electron-builder --win --dir"
  },
  "dependencies": {
    "@expo/env": "~2.0.8",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.8.1",
    "@supabase/supabase-js": "^2.105.4",
    "eas": "^0.1.0",
    "eas-cli": "^21.4.0",
    "expo": "~54.0.35",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "naija-state-local-government": "^1.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.55.0",
    "supabase": "^2.109.0",
    "typescript": "~5.9.2"
  },
  "build": {
    "appId": "ng.view2connect.sellerportal",
    "productName": "View2Connect Seller Portal",
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "dist/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "View2Connect Seller Portal"
    },
    "artifactName": "View2Connect-Seller-Portal-Setup.exe"
  }
}
