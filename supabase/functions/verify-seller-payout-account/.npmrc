import "@supabase/functions-js/edge-runtime.d.ts";
import { withSupabase } from "npm:@supabase/server";

export default {
  fetch: withSupabase({ auth: "user" }, async (req) => {
    try {
      const flutterwaveSecretKey = Deno.env.get("FLUTTERWAVE_SECRET_KEY");

      if (!flutterwaveSecretKey) {
        return Response.json(
          { message: "Flutterwave secret key is not configured." },
          { status: 500 },
        );
      }

      const body = await req.json();

      const bankCode = String(body.bankCode ?? body.account_bank ?? "").trim();
      const bankName = String(body.bankName ?? "").trim();
      const accountNumber = String(body.accountNumber ?? body.account_number ?? "")
        .replace(/\D/g, "")
        .slice(0, 10);

      if (!bankCode) {
        return Response.json(
          { message: "Bank code is required." },
          { status: 400 },
        );
      }

      if (accountNumber.length !== 10) {
        return Response.json(
          { message: "A valid 10-digit account number is required." },
          { status: 400 },
        );
      }

      const response = await fetch("https://api.flutterwave.com/v3/accounts/resolve", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${flutterwaveSecretKey}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          account_number: accountNumber,
          account_bank: bankCode,
        }),
      });

      const payload = await response.json();

      if (!response.ok) {
        return Response.json(
          {
            message: payload?.message ?? "Flutterwave could not verify this account.",
            flutterwave: payload,
          },
          { status: response.status },
        );
      }

      const accountName = String(payload?.data?.account_name ?? "").trim();

      if (!accountName) {
        return Response.json(
          { message: "Flutterwave did not return an account name." },
          { status: 400 },
        );
      }

      return Response.json({
        bankCode,
        bankName,
        accountNumber,
        accountName,
        verifiedAt: new Date().toISOString(),
      });
    } catch (error) {
      return Response.json(
        {
          message: error instanceof Error ? error.message : "Unable to verify account.",
        },
        { status: 500 },
      );
    }
  }),
};