import "@supabase/functions-js/edge-runtime.d.ts";
import { withSupabase } from "npm:@supabase/server";

export default {
  fetch: withSupabase({ auth: "user" }, async () => {
    try {
      const flutterwaveSecretKey = Deno.env.get("FLUTTERWAVE_SECRET_KEY");

      if (!flutterwaveSecretKey) {
        return Response.json(
          { message: "Flutterwave secret key is not configured." },
          { status: 500 },
        );
      }

      const response = await fetch("https://api.flutterwave.com/v3/banks/NG", {
        method: "GET",
        headers: {
          Authorization: `Bearer ${flutterwaveSecretKey}`,
          "Content-Type": "application/json",
        },
      });

      const payload = await response.json();

      if (!response.ok) {
        return Response.json(
          {
            message: payload?.message ?? "Unable to fetch Nigerian banks from Flutterwave.",
            flutterwave: payload,
          },
          { status: response.status },
        );
      }

      const banks = Array.isArray(payload?.data)
        ? payload.data
            .map((bank: { name?: unknown; code?: unknown }) => ({
              name: String(bank.name ?? "").trim(),
              code: String(bank.code ?? "").trim(),
            }))
            .filter((bank: { name: string; code: string }) => bank.name && bank.code)
        : [];

      return Response.json(banks);
    } catch (error) {
      return Response.json(
        {
          message: error instanceof Error ? error.message : "Unable to load banks.",
        },
        { status: 500 },
      );
    }
  }),
};