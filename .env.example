# Secure admin panel token for the web control center.
EXPO_PUBLIC_ADMIN_ACCESS_TOKEN=replace-with-a-long-random-token

# Public Supabase browser/mobile config. Never put the PostgreSQL password here.
# Use https://auth.view2connect.ng only after that Supabase custom domain is active.
# Until then, keep the real project URL so Auth and Edge Functions continue working.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Local testing switch. Use true when your hosted Supabase project is paused/restricted.
# It disables Supabase reads/writes and stores test data under separate local keys.
EXPO_PUBLIC_URBANCONNECT_LOCAL_TEST_MODE=false

# Server-only Flutterwave config for Supabase Edge Functions. Do not prefix with EXPO_PUBLIC.
FLUTTERWAVE_CLIENT_ID=replace-with-flutterwave-client-id
FLUTTERWAVE_CLIENT_SECRET=replace-with-flutterwave-client-secret
FLUTTERWAVE_ENCRYPTION_KEY=replace-with-flutterwave-encryption-key
FLUTTERWAVE_SECRET_KEY=replace-with-your-flutterwave-live-secret-key
FLUTTERWAVE_REDIRECT_URL=https://www.view2connect.ng/payments/flutterwave/return/
FLUTTERWAVE_WEBHOOK_SECRET_HASH=replace-with-flutterwave-webhook-secret-hash

# Server-only Resend config for Supabase Edge Functions.
RESEND_API_KEY=re_replace-with-resend-api-key
RESEND_FROM_EMAIL=View2Connect <receipts@view2connect.ng>
RESEND_REPLY_TO=support@view2connect.ng

# Server-only Termii config for Supabase Edge Functions.
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=replace-with-termii-api-key
TERMII_SENDER_ID=View2Conn
TERMII_CHANNEL=generic

# Public website/build-time config.
VIEW2CONNECT_SITE_URL=https://www.view2connect.ng
URBANCONNECT_SITE_URL=https://www.view2connect.ng
URBANCONNECT_LOGO_URL=https://www.view2connect.ng/assets/view2connect-mark.svg
URBANCONNECT_APP_STORE_URL=https://apps.apple.com/app/replace-with-your-app-id
URBANCONNECT_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.urbanconnect.app
